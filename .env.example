# Generate .env with python3 scripts/init_env.py. Never commit .env.
COMPOSE_PROJECT_NAME=ti-lab
TZ=UTC
BASE_URL=http://localhost:8081
ADMIN_EMAIL=admin@intel.test
ADMIN_ORG=Private Intel Lab
ADMIN_PASSWORD=CHANGE_MISP_PASSWORD
ADMIN_KEY=CHANGE_MISP_API_KEY
MYSQL_PASSWORD=CHANGE_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_DB_ROOT_PASSWORD
REDIS_PASSWORD=CHANGE_REDIS_PASSWORD
GPG_PASSPHRASE=CHANGE_GPG_PASSPHRASE
ENCRYPTION_KEY=CHANGE_MISP_ENCRYPTION_KEY
SALT=CHANGE_MISP_SALT
OPENCTI_ADMIN_EMAIL=admin@intel.test
OPENCTI_ADMIN_PASSWORD=CHANGE_OPENCTI_PASSWORD
OPENCTI_ADMIN_TOKEN=CHANGE_OPENCTI_TOKEN
OPENCTI_HEALTH_KEY=CHANGE_HEALTH_KEY
OPENCTI_ENCRYPTION_KEY=CHANGE_OPENCTI_ENCRYPTION_KEY
MINIO_ROOT_USER=opencti
MINIO_ROOT_PASSWORD=CHANGE_MINIO_PASSWORD
RABBITMQ_DEFAULT_USER=opencti
RABBITMQ_DEFAULT_PASS=CHANGE_RABBITMQ_PASSWORD
MISP_CONNECTOR_ID=CHANGE_CONNECTOR_ID
MISP_IMPORT_FROM_DATE=2026-11-01
# Host-native pipeline talks only to VM loopback.
MISP_URL=http://127.0.0.1:8081
MISP_API_KEY=
OPENCTI_URL=http://127.0.0.1:8080
OPENCTI_TOKEN=
OLLAMA_URL=http://127.0.0.1:11434
# Choose from ollama list after assessment. No model is downloaded automatically.
OLLAMA_MODEL=
# Narrative inference; staged public operation uses one publication-wide call.
# False retains a checked source-grounded fallback.
TI_NARRATIVE_ENABLED=true
# Keep only MISP resident by default; use all after a measured combined pilot.
TI_RESIDENT_PROFILE=misp

# Optional public dashboard; outbound GitHub CLI authentication required.
# Publishes ONLY original public-source projections, never the local database.
TI_PUBLICATION_ENABLED=false
TI_PUBLICATION_REPOSITORY=bran-dot-flake/STIX-TAXII-Threat-Intel-Automated-Summary

# Optional one-shot STIX/TAXII stages; install .[stix] in a project venv.
TI_TAXII_ENABLED=false
TI_STIX_PYTHON=work/stix-venv/bin/python3
TI_STIX_OPENCTI_ENABLED=false
# Only for explicitly configured non-MITRE/private TAXII sources. Never publish.
TAXII_USER=
TAXII_PASSWORD=
TAXII_TOKEN=
